# Caddy가 자동 HTTPS 인증서를 발급할 공개 도메인이다. 스킴이나 경로를 넣지 않는다.
SITE_ADDRESS=marketvalley.example.com
NEXT_PUBLIC_SITE_URL=https://marketvalley.example.com

# 기존 k3s/Traefik의 80·443과 분리해 VM 사설 IP의 고포트에만 bind한다.
# OCI NLB가 public 80·443을 각각 이 포트로 전달한다.
MARKETVALLEY_BIND_ADDRESS=10.0.0.9
MARKETVALLEY_HTTP_PORT=13080
MARKETVALLEY_HTTPS_PORT=13443

CAMPAIGN_GENERATOR_MODE=anthropic
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=replace-with-server-secret

CAMPAIGN_REPOSITORY_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SECRET_KEY=replace-with-server-secret
SUPABASE_SERVICE_ROLE_KEY=
SIGNAL_HASH_SECRET=replace-with-at-least-32-random-bytes

# 공개 예약은 운영 origin과 Turnstile hostname을 정확히 일치시켜 검증한다.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-server-secret
TURNSTILE_VERIFY_TIMEOUT_MS=3000
RESERVATION_CAMPAIGN_MINUTE_LIMIT=10
RESERVATION_GLOBAL_MINUTE_LIMIT=120
RESERVATION_CAMPAIGN_TOTAL_LIMIT=1000

AI_RATE_LIMIT_MAX_REQUESTS=3
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_DAILY_USER_LIMIT=30
AI_DAILY_GLOBAL_LIMIT=300

# Meta는 기본 비활성이다. live 전환 시 아래 모든 값이 서버 검증을 통과해야 한다.
META_ADS_MODE=disabled
META_OPERATION_LEDGER_MODE=supabase
META_DRAFT_OPERATOR_USER_IDS=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_INSTAGRAM_ACTOR_ID=
META_VERIFIED_PAGE_INSTAGRAM_BINDING=
META_PAGE_INSTAGRAM_BINDING_VERIFIED_AT=
META_ALLOWED_DESTINATION_ORIGIN=
META_MAX_LIFETIME_BUDGET_MINOR=50000
META_DRAFT_LIFETIME_BUDGET_MINOR=10000
META_DRAFT_DAILY_OWNER_LIMIT=2
META_DRAFT_DAILY_GLOBAL_LIMIT=50
META_DRAFT_LEAD_MINUTES=10
META_DRAFT_DURATION_HOURS=24
META_ACCESS_TOKEN=
META_APP_SECRET=
