# 제품 기본값은 Claude 문구 생성이다. 자동 테스트와 비상 발표만 fixture를 명시한다.
CAMPAIGN_GENERATOR_MODE=anthropic
# Anthropic API 호출부터 과금된다. 서버 전용 키만 사용한다.
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 제품 실행은 Google OAuth가 연결된 Supabase 세션을 사용한다. fixture와 mock은 자동 테스트에서만 명시한다.
NEXT_PUBLIC_AUTH_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=
# Supabase Connect 화면의 publishable key를 사용한다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 기존 프로젝트의 legacy anon key도 임시 호환한다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 계정별 RLS와 재시작 복구가 필요하므로 제품 기본 저장소는 Supabase다.
CAMPAIGN_REPOSITORY_MODE=supabase
# Supabase의 새 secret key를 우선 사용하고, legacy 프로젝트만 service role key를 사용한다.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 실제 값은 32바이트 이상의 무작위 서버 secret이어야 하며 배포 후 임의로 바꾸지 않는다.
SIGNAL_HASH_SECRET=
# Vercel Cron과 Oracle lifecycle worker가 같은 값을 Bearer token으로 사용한다.
CRON_SECRET=
# Supabase 공개 예약은 canonical HTTPS origin과 같은 hostname의 Turnstile widget을 요구한다.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_TIMEOUT_MS=3000
RESERVATION_CAMPAIGN_MINUTE_LIMIT=10
RESERVATION_GLOBAL_MINUTE_LIMIT=120
RESERVATION_CAMPAIGN_TOTAL_LIMIT=1000

# Meta Marketing API는 production + Supabase durable ledger에서만 live로 전환한다.
# 자동 활성화는 allowlist 사용자, 정확한 광고계정, 정확한 lifetime budget 확인값이 모두 일치할 때만 열린다.
META_ADS_MODE=disabled
META_OPERATION_LEDGER_MODE=supabase
META_DRAFT_OPERATOR_USER_IDS=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_INSTAGRAM_ACTOR_ID=
META_VERIFIED_PAGE_INSTAGRAM_BINDING=
META_PAGE_INSTAGRAM_BINDING_VERIFIED_AT=
META_ALLOWED_DESTINATION_ORIGIN=
META_MAX_LIFETIME_BUDGET_MINOR=50000
META_DRAFT_LIFETIME_BUDGET_MINOR=10000
META_DRAFT_LEAD_MINUTES=10
META_DRAFT_DURATION_HOURS=24
META_INSIGHTS_FINALIZATION_DELAY_MINUTES=60
META_ACCESS_TOKEN=
META_APP_SECRET=
META_AUTO_ACTIVATION_ENABLED=false
META_AUTO_ACTIVATION_AD_ACCOUNT_ID=
META_AUTO_ACTIVATION_LIFETIME_BUDGET_MINOR=10000
