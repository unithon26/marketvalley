# 제품 기본값은 Claude 문구 생성이다. 자동 테스트와 비상 발표만 fixture를 명시한다.
CAMPAIGN_GENERATOR_MODE=anthropic
# Anthropic API 호출부터 과금된다. 서버 전용 키만 사용한다.
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
# Supabase 모드에서는 분당·사용자 일일·전체 일일 한도를 DB RPC가 원자적으로 집계한다.
AI_RATE_LIMIT_MAX_REQUESTS=3
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_DAILY_USER_LIMIT=30
AI_DAILY_GLOBAL_LIMIT=300
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Supabase Connect 화면의 publishable key를 사용한다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 기존 프로젝트의 legacy anon key도 임시 호환한다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 기본 fixture는 실제 DB를 읽거나 쓰지 않는다. 배포 전 migration 적용 뒤 supabase로 전환한다.
CAMPAIGN_REPOSITORY_MODE=fixture
# Supabase의 새 secret key를 우선 사용하고, legacy 프로젝트만 service role key를 사용한다.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 실제 값은 32바이트 이상의 무작위 서버 secret이어야 하며 배포 후 임의로 바꾸지 않는다.
SIGNAL_HASH_SECRET=
# Supabase 공개 예약은 canonical HTTPS origin과 같은 hostname의 Turnstile widget을 요구한다.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_TIMEOUT_MS=3000
RESERVATION_CAMPAIGN_MINUTE_LIMIT=10
RESERVATION_GLOBAL_MINUTE_LIMIT=120
RESERVATION_CAMPAIGN_TOTAL_LIMIT=1000
