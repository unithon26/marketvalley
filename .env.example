# 제품 기본값은 OpenAI 문구 생성이다. 자동 테스트와 비상 발표만 fixture를 명시한다.
CAMPAIGN_GENERATOR_MODE=openai
# OpenAI API 호출부터 과금된다. 노출 이력 없는 회전된 서버 키만 사용한다.
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Supabase Connect 화면의 publishable key를 사용한다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 기존 프로젝트의 legacy anon key도 임시 호환한다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SIGNAL_HASH_SECRET=
